# Advertising is off unless a publisher id is set. With this file absent the
# site behaves exactly as if none of it existed: no banner, no slots, and no
# request to anybody. Copy to .env.local to turn it on.

# Google AdSense publisher id, e.g. ca-pub-1234567890123456
NEXT_PUBLIC_ADS_CLIENT=

# The two ad units: one below each tool, one at the foot of the market.
NEXT_PUBLIC_ADS_SLOT_TOOL=
NEXT_PUBLIC_ADS_SLOT_MARKET=

# Used for canonical URLs, hreflang and the sitemap.
NEXT_PUBLIC_SITE_URL=https://invoicefast.app
